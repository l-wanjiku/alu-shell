#!/usr/bin/env bash
# Creates a PID file in /var/run, handles signals, and cleans up on exit

pid_file="/var/run/myscript.pid"

echo "$$" > "$pid_file"

trap 'echo "Y U no love me?!"' SIGINT
trap 'echo "I hate the kill command"; rm -f "$pid_file"; exit' SIGTERM SIGQUIT

while true; do
    echo "To infinity and beyond"
    sleep 2
done
